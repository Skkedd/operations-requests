{
  "rewrites": [
    { "source": "/requests/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/requests/favicon.png", "destination": "/favicon.png" },
    { "source": "/requests/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
